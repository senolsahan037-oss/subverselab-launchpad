rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /seo_articles/{document=**} {
      allow read: if true;
      // Matches the admin custom claim metadata-sync-service's verifyAdmin()
      // already checks. SEOAdminTab's publish/unpublish/edit/delete write
      // straight from the client SDK (seoService.js) — until this rule
      // existed, every one of those writes fell through to the default-deny
      // catch-all below and failed with "Missing or insufficient
      // permissions," regardless of the caller's claim.
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /products/{document=**} {
      allow read: if true;
    }
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Plugin orders and licence keys, written only by server.js from signed
    // Lemon Squeezy webhooks (Admin SDK, which bypasses these rules). One
    // document per buyer, keyed by the lowercased checkout e-mail. A signed-in
    // user may read only the document for their own address, and only once
    // Firebase has verified that they own it — otherwise anyone could register
    // with a buyer's e-mail and read the buyer's keys. No client writes.
    match /plugin_licenses/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email.lower() == email;
      allow write: if false;
    }
    match /analytics/{document=**} {
      allow read: if request.auth != null;
    }
    match /reports/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /forum_topics/{topicId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      match /replies/{replyId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
