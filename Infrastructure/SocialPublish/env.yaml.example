# Copy to env.yaml and fill in real values before deploying:
#   gcloud run deploy social-publish --source . \
#     --project project-62238635-aae4-41f4-880 --region europe-west1 \
#     --env-vars-file env.yaml --allow-unauthenticated
# env.yaml is deploy-time config only. Never commit the real env.yaml.

GOOGLE_CLOUD_PROJECT: "project-62238635-aae4-41f4-880"
FIREBASE_STORAGE_BUCKET: "project-62238635-aae4-41f4-880.firebasestorage.app"
ALLOWED_ORIGINS: "https://subverselab.com,https://www.subverselab.com"
NODE_ENV: "production"

# Random long string. Sent as the X-Cron-Secret header by Cloud Scheduler
# when it hits /internal/run-scheduled-publish. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET: "REPLACE_WITH_RANDOM_SECRET"

# From the Google Cloud OAuth 2.0 Client ID (Desktop app type) created for
# YouTube Data API v3 access. See Scripts/social-publish-oauth-setup.js for
# the one-time consent flow that produces the refresh token stored in
# Firestore (social_publish_config/youtube) — that token is NOT set here.
YT_CLIENT_ID: "REPLACE_WITH_YOUTUBE_OAUTH_CLIENT_ID"
YT_CLIENT_SECRET: "REPLACE_WITH_YOUTUBE_OAUTH_CLIENT_SECRET"
# "private" by default on purpose — matches this team's standing rule from
# the ConfessionPub channel: uploads land private, going public is always a
# separate manual step done in YouTube Studio, never automatic.
YT_DEFAULT_PRIVACY_STATUS: "private"
# Hard safety check before every upload — publishVideo() aborts if the
# authorized token doesn't resolve to this exact channel ID. Get it from
# youtube.channels.list({mine:true}) once OAuth is set up.
YT_EXPECTED_CHANNEL_ID: "REPLACE_WITH_SUBVERSE_LAB_CHANNEL_ID"

# From the Meta App (Instagram Graph API product). The long-lived Page token
# and IG Business Account ID are NOT set here — they live in Firestore
# (social_publish_config/instagram) because they need periodic rotation
# without a redeploy. See Scripts/social-publish-oauth-setup.js.
IG_APP_ID: "REPLACE_WITH_META_APP_ID"
IG_APP_SECRET: "REPLACE_WITH_META_APP_SECRET"

# Web config for the review UI's sign-in button (public/index.html). These
# are public-safe values (Firebase's client-side API key is not a secret),
# not the same as the server-side Application Default Credentials.
FIREBASE_WEB_API_KEY: "REPLACE_WITH_FIREBASE_WEB_API_KEY"
FIREBASE_WEB_AUTH_DOMAIN: "project-62238635-aae4-41f4-880.firebaseapp.com"

# Set to "true" only for local testing without real Instagram/YouTube
# credentials — routes real content through fake publishers instead.
# Must be "false" (or unset) in any real deployment.
USE_STUB_PUBLISHERS: "false"
